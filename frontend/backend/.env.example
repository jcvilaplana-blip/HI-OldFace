# Servidor
NODE_ENV=development
PORT=3001

# URL frontend permitida en CORS
FRONTEND_URL=http://localhost:5173
# En producción cambiar a:
# FRONTEND_URL=https://oldface.app

# Panel de administrador (/admin) — sin estas dos variables el login de admin queda desactivado
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambia-esta-contraseña

# Servidor RTC propio (llamadas, directos, karaoke): secretos compartidos con rtc-server
RTC_SECRET=genera-un-valor-aleatorio-largo
TURN_SECRET=genera-otro-valor-aleatorio-largo
RTC_INTERNAL_URL=http://127.0.0.1:4000

# Sesión: por defecto todas las rutas de usuario exigen el token (Authorization: Bearer). Solo en una emergencia:
# AUTH_MODE=registro acepta peticiones sin sesión (como antes) y las anota en el log
# AUTH_MODE=exigir

# OldFace AI (Willy). Sin ANTHROPIC_API_KEY Willy aparece como "no disponible". La clave SOLO aquí, nunca en la app.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5        # modelo de Claude
# AI_EFFORT=medium                # low | medium | high (más alto = más razonamiento y más coste)
# AI_DAILY_LIMIT=40               # consultas a Willy por usuario y día
# AI_PROVIDER=anthropic           # anthropic | mock (pruebas, sin IA) | off
# AI_FALLBACKS=1                  # 0 = no reintentar con otro modelo si Claude rechaza una petición

# Android App Links: huellas SHA-256 extra del certificado de firma (p. ej. Play Store), separadas por comas
# ANDROID_CERT_SHA256=AA:BB:...

# Email (OTP) por SMTP
# SMTP_HOST=smtp.ionos.es
# SMTP_PORT=587
# SMTP_USER=contacto@oldface.app
# SMTP_PASS=...
