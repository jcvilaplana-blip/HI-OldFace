# Servidor
NODE_ENV=development
PORT=3001

# URL frontend permitida en CORS
FRONTEND_URL=http://localhost:5173
# En producción cambiar a:
# FRONTEND_URL=https://oldface.app

# Panel de administrador (/admin) — sin estas dos variables el login de admin queda desactivado
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambia-esta-contraseña

# Servidor RTC propio (llamadas, directos, karaoke): secretos compartidos con rtc-server
RTC_SECRET=genera-un-valor-aleatorio-largo
TURN_SECRET=genera-otro-valor-aleatorio-largo
RTC_INTERNAL_URL=http://127.0.0.1:4000

# Sesión: por defecto todas las rutas de usuario exigen el token (Authorization: Bearer). Solo en una emergencia:
# AUTH_MODE=registro acepta peticiones sin sesión (como antes) y las anota en el log
# AUTH_MODE=exigir

# OldFace AI (Willy). Sin ANTHROPIC_API_KEY Willy aparece como "no disponible". La clave SOLO aquí, nunca en la app.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5        # modelo de Claude
# AI_EFFORT=medium                # low | medium | high (más alto = más razonamiento y más coste)
# AI_DAILY_LIMIT=40               # consultas a Willy por usuario y día
# AI_PROVIDER=anthropic           # anthropic | local (modelo libre en llm-server/, gratis) | mock (pruebas, sin IA) | off
# LOCAL_LLM_URL=http://127.0.0.1:8089   # con AI_PROVIDER=local: servicio oldface-llm (nunca un servicio externo)
# LOCAL_LLM_MODEL=qwen3-8b        # nombre informativo del modelo local
# LOCAL_LLM_MAX_TOKENS=1024       # largo máximo de cada respuesta del modelo local
# AI_FALLBACKS=1                  # 0 = no reintentar con otro modelo si Claude rechaza una petición
# Voz de Willy en el servidor (voice-server/, Piper). Sin PIPER_URL la app usa la voz del móvil.
# PIPER_URL=http://127.0.0.1:5010 # servicio local de voz (nunca un servicio externo)
# TTS_PROVIDER=piper              # piper | mock (pruebas) | off
# AI_VOICE_DAILY_LIMIT=400        # frases leídas por usuario y día
# Búsqueda por significado (embed-server/, EmbeddingGemma). Sin EMBED_URL Willy busca solo por palabras.
# EMBED_URL=http://127.0.0.1:8090 # servicio local oldface-embed (nunca un servicio externo)
# AI_SEMANTIC_MIN=0.45            # parecido mínimo para contar como coincidencia
# AI_SEMANTIC_MARGIN=0.05         # y como mucho esta distancia al mejor resultado de la búsqueda
# Taxi para Willy (taxis cerca, destino y precio aproximado): API interna del taxi-server, con RTC_SECRET
# TAXI_INTERNAL_URL=http://127.0.0.1:4100
# Qué hay dentro de los archivos (Fase 3): fotos y vídeos (vision-server/), audios (whisper-server/), PDF (pdf.js)
# VISION_URL=http://127.0.0.1:8091   # servicio local oldface-vision (Qwen3-VL 2B)
# WHISPER_URL=http://127.0.0.1:8092  # servicio local oldface-whisper (whisper.cpp)
# FFMPEG_PATH=                       # por defecto el de rtc-server/node_modules/ffmpeg-static ("none" = sin ffmpeg)
# AI_MEDIA=off                       # desactiva el análisis de archivos para todos

# Android App Links: huellas SHA-256 extra del certificado de firma (p. ej. Play Store), separadas por comas
# ANDROID_CERT_SHA256=AA:BB:...

# Email (OTP) por SMTP
# SMTP_HOST=smtp.ionos.es
# SMTP_PORT=587
# SMTP_USER=contacto@oldface.app
# SMTP_PASS=...
