[Unit]
Description=OldFace cerebro libre de Willy (llama.cpp + Qwen3 8B, solo 127.0.0.1)
After=network-online.target
Wants=network-online.target

[Service]
User=oldface.app_k1i7f62xmt8
Group=psacln
WorkingDirectory=/var/www/vhosts/oldface.app/llm-server
Environment=LD_LIBRARY_PATH=/var/www/vhosts/oldface.app/llm-server/llama
# 6 de los 12 núcleos y prioridad baja: llamadas, videollamadas y directos van primero
ExecStart=/var/www/vhosts/oldface.app/llm-server/llama/llama-server \
  -m /var/www/vhosts/oldface.app/llm-server/models/qwen3-8b-q4km.gguf --alias qwen3-8b \
  --host 127.0.0.1 --port 8089 -c 16384 -np 1 -t 6 --jinja \
  --no-webui --no-webui-mcp-proxy --no-slots
Nice=10
CPUQuota=600%
MemoryMax=10G
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
