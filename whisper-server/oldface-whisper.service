[Unit]
Description=OldFace transcripción de audios de Willy (whisper.cpp small, solo 127.0.0.1)
After=network-online.target
Wants=network-online.target

[Service]
User=oldface.app_k1i7f62xmt8
Group=psacln
WorkingDirectory=/var/www/vhosts/oldface.app/whisper-server
# 4 núcleos y la prioridad más baja: solo transcribe en segundo plano
ExecStart=/var/www/vhosts/oldface.app/whisper-server/bin/whisper-server \
  -m /var/www/vhosts/oldface.app/whisper-server/models/ggml-small-q8_0.bin \
  --host 127.0.0.1 --port 8092 -t 4 -l auto
Nice=15
CPUQuota=400%
MemoryMax=2G
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
